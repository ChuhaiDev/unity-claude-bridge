def console_since(level="warn", tail=200, everything=False):
    params = {"tail": tail, "level": level}
    if not everything:
        try:
            with open(CURSOR) as f:
                c = json.load(f)
            params.update(since=c["cursor"], since_session=c["session"])
        except (OSError, ValueError, KeyError):
            pass
    res = run("console", params, show=False) or {}
    os.makedirs(STATE, exist_ok=True)
    with open(CURSOR, "w") as f:
        json.dump({"cursor": res.get("cursor"), "session": res.get("session")}, f)
    return res


def print_entries(res, limit=25):
    """Dedupe repeats (×n), keep the first project stack frame, cap the count."""
    rows, index = [], {}
    for e in res.get("entries", []):
        msg = (e.get("message") or "").strip()
        if "/api/exec" in msg or msg.startswith(("ExecuteCommandByName", "[Pipeline]")):
            continue
        first = msg.split("\n")[0][:300]
        st = (e.get("stackTrace") or e.get("stacktrace") or "").split("\n")
        loc = next((l.strip() for l in st if "Assets/" in l), "")
        loc = re.sub(r".*\(at (Assets/[^)]+)\).*", r"\1", loc)
        key = (first, loc)
        if key in index:
            rows[index[key]][3] += 1
            continue
        index[key] = len(rows)
        rows.append([(e.get("level") or e.get("type") or "?")[:5], first, loc, 1])
    lines = ["%s %s%s%s" % (lv, msg, ("  @ " + loc) if loc else "", (" ×%d" % n) if n > 1 else "") for lv, msg, loc, n in rows]
    if len(lines) > limit:
        lines = lines[:limit] + ["… %d more distinct entries" % (len(lines) - limit)]
    if (res.get("groundTruth") or {}).get("compilationFailed"):
        lines.append("!! scripts don't compile — `u sync` shows the errors")
    if lines:
        out("\n".join(lines))
    return len(rows)


def cmd_errors(args):
    if print_entries(console_since("warn", 200, bool(args and args[0] == "all"))) == 0:
        print("no new warnings/errors")


def cmd_logs(args):
    if print_entries(console_since("log", 200, bool(args and args[0] == "all")), limit=40) == 0:
        print("no new console output")


def wait_play_state(want, timeout=60):
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            if (editor_state().get("playMode") in ("playing", "paused")) == want:
                return True
        except EditorDown:
            pass
        time.sleep(0.25)
    return False


def cmd_play(args):
    secs = next((float(a) for a in args if re.match(r"^[0-9.]+$", a)), 3.0)
    console_since("log", 1)
    run("editor_play", {}, show=False)
    if not wait_play_state(True):
        raise Fail("didn't enter play mode (compile errors? `u sync`)")
    log_activity("cmd", "play", "running %.1fs" % secs)
    time.sleep(secs)
    if "noshot" not in args:
        cmd_shot(["game", "play-%s" % datetime.now().strftime("%H%M%S")])
    if print_entries(console_since("log", 200), limit=30) == 0:
        print("(no console output)")
    if "keep" in args:
        print("still playing — `u editor_stop` when done")
    else:
        run("editor_stop", {}, show=False)
        wait_play_state(False)
        print("stopped")


def cmd_run(args):
    if not args:
        raise Fail("usage: u run <file.cs> [Type.Method] [json-args]")
    params = {"file": os.path.relpath(os.path.abspath(args[0]), PROJECT)}
    if len(args) > 1:
        params["entry"] = args[1]
    if len(args) > 2:
        params["args"] = json.loads(args[2])
    rep = call("run_script", params)
    log_activity("cmd", "run_script", params, bool(rep.get("success")), 0, None if rep.get("success") else error_text(rep))
    res = rep.get("result") or {}
    diags = [d for d in (res.get("diagnostics") or []) if d.get("severity") in ("error", "Error", "warning", "Warning")]
    for d in diags[:15]:
        print("%s %s" % (d.get("severity", ""), d.get("message") or json.dumps(d)), file=sys.stderr)
    if not rep.get("success"):
        raise Fail(error_text(rep))
    out(render(res.get("result")))


def cmd_cmds(args):
    q = "&query=" + urllib.parse.quote(args[0]) if args else ""
    _, rep = http("GET", "/api/commands?detail=compact" + q)
    rows = sorted(rep.get("commands", []), key=lambda c: c["name"])
    out("\n".join("%-26s %s" % (c["name"], c.get("description", "")[:90]) for c in rows))


def cmd_help(args):
    if not args:
        print(__doc__)
        return
    name = ALIASES.get(args[0], args[0])
    _, rep = http("GET", "/api/commands?detail=full&query=" + urllib.parse.quote(name))
    for c in rep.get("commands", []):
        if c["name"] != name:
            continue
        print("%s — %s" % (c["name"], c.get("description", "")))
        for p in c.get("parameters", []):
            dv = p.get("defaultValue")
            print("  %s%-16s %-9s %s%s" % ("*" if p.get("required") else " ", p.get("name"), p.get("type", ""), p.get("description", ""),
                                          (" [%s]" % dv) if dv not in (None, "") else ""))
        return
    raise Fail(unknown_command(name))


def cmd_wait(_):
    deadline = time.time() + 300
    while time.time() < deadline:
        try:
            _, rep = http("GET", "/api/status", timeout=5)
            if rep.get("status") == "ready":
                print("ready")
                return
        except EditorDown:
            pass
        time.sleep(1)
    raise Fail("editor not ready after 300s")


def cmd_status(_):
    st = editor_state()
    print(" ".join("%s=%s" % (k, st[k]) for k in ("status", "playMode", "compiling") if k in st))


COMPOSITE = {"sync": cmd_sync, "ls": cmd_ls, "set": cmd_set, "apply": cmd_apply, "rm": cmd_rm, "diff": cmd_diff,
             "shot": cmd_shot, "note": cmd_note, "errors": cmd_errors, "logs": cmd_logs, "play": cmd_play, "run": cmd_run,
             "cmds": cmd_cmds, "help": cmd_help, "wait": cmd_wait, "status": cmd_status}


def dispatch(args):
    name = args[0]
    if name not in NO_AUTOSYNC:
        autosync()
    try:
        if name in COMPOSITE:
            COMPOSITE[name](args[1:])
        else:
            cmd = ALIASES.get(name, name)
            run(cmd, bind(cmd, args[1:]))
    finally:
        if name not in NO_AUTOSYNC and os.path.exists(STAMP):
            touch_stamp()


def batch(lines):
    """One command per line. `apply <<END` … `END` embeds multi-line scene text."""
    n, i = 0, 0
    while i < len(lines):
        line = lines[i].strip()
        i += 1
        if not line or line.startswith("#"):
            continue
        n += 1
        m = re.match(r"^(apply)\s*(.*?)<<\s*(\w+)$", line)
        try:
            if m:
                body = []
                while i < len(lines) and lines[i].strip() != m.group(3):
                    body.append(lines[i])
                    i += 1
                i += 1
                dispatch(["apply", "text=" + "\n".join(body)] + shlex.split(m.group(2)))
                continue
            dispatch(shlex.split(line))
        except Fail as e:
            print("✗ line %d `%s`\n%s" % (n, line[:120], e), file=sys.stderr)
            print("(stopped; earlier lines were applied)", file=sys.stderr)
            sys.exit(1)


def main():
    sys.stdout.reconfigure(line_buffering=True)
    try:
        if not ARGV:
            if sys.stdin.isatty():
                print(__doc__)
                return
            batch(sys.stdin.read().splitlines())
            return
        if ARGV[0] in ("-h", "--help"):
            print(__doc__)
            return
        dispatch(ARGV)
    except Fail as e:
        print("ERROR " + str(e), file=sys.stderr)
        sys.exit(1)
    except EditorDown as e:
        print("EDITOR DOWN: %s" % e, file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()
